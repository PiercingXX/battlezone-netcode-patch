# Build artifacts
build/
**/build/
*.o
*.obj
*.a
*.lib
*.so
*.dll
!**/Microslop/winmm.dll
!prebuilt/windows/winmm.dll
!prebuilt/linux/dsound.dll
!prebuilt/linux/dsound.dll.sha256

# Test bundles / captured run data. The retention policy is versioned; the
# bundles themselves are not.
test_bundles/
!test_bundles/README.md
*.exe
*.out
# Host-native test binaries (built by `make -C tests run`). Ignore by SHAPE, not
# by name: a compiled test is tests/<name>_test with no extension; sources end in
# .cpp/.h/.py so they're untouched. (Named-list approach let dampen_{epoch,purge,
# storm}_test slip in one at a time — 2026-08-11.)
tests/*_test
# Raw game logs are huge research data - keep analysis .md summaries, not the logs
test-logs/*BZLogger*.txt
test-logs/*.log
**/BZLogger*.txt
# Tester log drops land here under arbitrary names (165MB for one session)
new logs/

# Generated logs and diagnostics
*.log
*.tmp
*.cache
# But the committed analyze_drops pairing fixtures are real .log files
!tests/fixtures/proxy_pair_proxy.log
!tests/fixtures/proxy_pair_match_proxy.log
!tests/fixtures/proxy_pair_single_proxy.log

# Shell/PowerShell transient outputs
*.stackdump

# OS metadata
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Python bytecode from compileall in CI
__pycache__/
*.pyc

# Skippy runtime bookkeeping — never tracked
.skippy/
tests/send_dampen_test
tests/dampen_epoch_test
