+	-- NAVFIX2: rename a nav only when the name actually changed.
+	-- Rewriting an identical string still dirties the object, and the
+	-- composed name carries a live scrap count, so it churns constantly.
+	NavNameCache = NavNameCache or {}
+	function NavSetName(h, name)
+		-- ClearDeadNavs() nils entries inside NavManager, leaving holes, so
+		-- NavManager[x] can be nil here.  The original SetObjectiveName call
+		-- silently no-ops on a nil handle; a table lookup does not.
+		if h == nil then return end
+		if NavNameCache[h] ~= name then
+			NavNameCache[h] = name
+			if NAVFIX2_FIRED == nil then
+				DisplayMessage("NAVFIX2: rename guard active")
+				NAVFIX2_FIRED = true
+			end
+			SetObjectiveName(h, name)
+		end
+	end
